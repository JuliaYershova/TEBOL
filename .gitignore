.venv/
venv/
.idea/
.DS_Store
__pycache__/
*.py[cod]
.ipynb_checkpoints/
# images and derived artifacts live on the server, not in git —
# keep the folder skeleton, ignore the contents
data/raw/*
!data/raw/.gitkeep
artifacts/*/*
!artifacts/*/.gitkeep

# captions ARE committed, gzipped: 181 MB -> 10.6 MB, and they cannot be
# regenerated (temperature 1.0), so the code alone does not reproduce them
!artifacts/captions/*/
artifacts/captions/*/*
!artifacts/captions/*/*.jsonl.gz

# raw ImageNet bbox XML — re-downloadable, thousands of tiny files
data/annotations/*
!data/annotations/.gitkeep

# run output, not data
logs/
nohup.out

# data/manifest/ IS tracked on purpose: small csv, makes runs reproducible
#   (incl. the parsed + rescaled ground-truth boxes)
# results/ IS tracked on purpose: metrics + figures for the thesis

*.ckpt
*.pt
*.pth
*.npy
*.npz
*.parquet

# smer_global IS committed: 165 files, 16 MB, the per-word vocabulary ranking
# that the leakage argument is read off. The rest of artifacts/explanations is
# 434 MB of per-caption detail nobody reads directly, and it is reproducible --
# SMER is deterministic and LIME is seeded. Must come after *.parquet above,
# and each directory level has to be re-included before the file can be.
!artifacts/explanations/
!artifacts/explanations/*/
!artifacts/explanations/*/*/
!artifacts/explanations/*/*/*/
!artifacts/explanations/*/*/*/*/
artifacts/explanations/*/*/*/*/*
!artifacts/explanations/*/*/*/*/smer_global.parquet

# the bbox replies ARE committed: 19 MB of JSONL holding every prompt, raw
# reply and box. Unlike the overlays drawn from them they cannot be
# regenerated -- 22,655 calls at temperature 1.0 against a server that may
# not outlive the thesis -- and every bbox metric is computed from them.
!artifacts/bbox/
!artifacts/bbox/*/
artifacts/bbox/*/*
!artifacts/bbox/*/*.jsonl
*.pkl
.env
.env.*
!.env.example