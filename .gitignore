# images and derived artifacts live on the server, not in git —
# keep the folder skeleton, ignore the contents
data/raw/*
!data/raw/.gitkeep
artifacts/*/*
!artifacts/*/.gitkeep

# raw ImageNet bbox XML — re-downloadable, thousands of tiny files
data/annotations/*
!data/annotations/.gitkeep

# run output, not data
logs/
nohup.out

