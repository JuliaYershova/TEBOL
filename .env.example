# Copy to .env and fill in. .env is gitignored -- never commit real values.

# OpenAI-compatible inference gateway, must end in /v1
LOCAL_OPENAI_BASE_URL=
LOCAL_OPENAI_API_KEY=

# model names as the gateway exposes them
LOCAL_MODEL_VISION=
LOCAL_MODEL_TEXT=
LOCAL_MODEL_EMBED=

# only needed for --backend openai
OPENAI_API_KEY=
